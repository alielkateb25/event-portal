{% extends 'base.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
<h1>Event index</h1>

<form method="GET" class="mb-4">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Search events..." value="{{ search ?? '' }}">
        <button class="btn btn-primary" type="submit">🔍 Search</button>
        {% if search %}
        <a href="{{ path('app_event_index') }}" class="btn btn-outline-secondary">Clear</a>
        {% endif %}
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>EventDate</th>
            <th>Location</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody>
        {% for event in events %}
        <tr>
            <td>{{ event.id }}</td>
            <td>{{ event.title }}</td>
            <td>{{ event.description }}</td>
            <td>{{ event.eventDate ? event.eventDate|date('Y-m-d H:i:s') : '' }}</td>
            <td>{{ event.location }}</td>
            <td>
                <a href="{{ path('app_event_show', {'id': event.id}) }}">show</a>
                <a href="{{ path('app_event_edit', {'id': event.id}) }}">edit</a>
            </td>
        </tr>
        {% else %}
        <tr>
            <td colspan="6">no records found</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<a href="{{ path('app_event_new') }}">Create new</a>
{% endblock %}