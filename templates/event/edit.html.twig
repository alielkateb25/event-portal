{% extends 'base.html.twig' %}

{% block title %}Edit Event{% endblock %}

{# ── Scoped styles for the Edit Event page only ── #}
{% block stylesheets %}
<style>
  /* ── Layout wrapper ── */
  .edit-page-wrapper {
    padding: 2.5rem 0 4rem;
  }

  /* ── Page heading row ── */
  .edit-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .edit-header-icon {
    width: 3.25rem;
    height: 3.25rem;
    background: linear-gradient(135deg, var(--ep-primary) 0%, #9333EA 100%);
    border-radius: var(--ep-radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(124,58,237,.35);
  }
  .edit-header-title {
    font-family: var(--ep-font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--ep-text);
    margin: 0 0 .1rem;
    line-height: 1.2;
  }
  .edit-header-sub {
    font-size: .875rem;
    color: var(--ep-text-muted);
    margin: 0;
  }

  /* ── Form card actions bar ── */
  .edit-form-actions {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ep-border);
    margin-top: .5rem;
  }

  /* ── Danger zone ── */
  .danger-zone {
    border: 1.5px solid rgba(239, 68, 68, .3);
    border-radius: var(--ep-radius);
    padding: 1.5rem 1.75rem;
    background: rgba(239, 68, 68, .04);
  }
  [data-bs-theme="dark"] .danger-zone {
    background: rgba(239, 68, 68, .07);
    border-color: rgba(239, 68, 68, .25);
  }
  .danger-zone-label {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--ep-danger);
    margin-bottom: .4rem;
  }
  .danger-zone-desc {
    font-size: .875rem;
    color: var(--ep-text-muted);
    margin-bottom: 1rem;
  }
</style>
{% endblock %}

{% block body %}
<div class="edit-page-wrapper">
  <div class="container" style="max-width: 780px;">

    {# ── Back navigation ── #}
    <a href="{{ path('app_event_index') }}" class="btn btn-secondary btn-sm mb-4">
      <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to list
    </a>

    {# ── Page heading ── #}
    <div class="edit-header">
      <div class="edit-header-icon" aria-hidden="true">✏️</div>
      <div>
        <h1 class="edit-header-title">Edit Event</h1>
        <p class="edit-header-sub">Update the details of your event below, then click <strong>Update</strong>.</p>
      </div>
    </div>

    {# ── Divider accent ── #}
    <div class="section-divider mb-4"></div>

    {# ── Form card ── #}
    <div class="form-card">
      {{ include('event/_form.html.twig', {'button_label': 'Update'}) }}
    </div>

    {# ── Danger zone ── #}
    <div class="danger-zone mt-4">
      <p class="danger-zone-label">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        Danger Zone
      </p>
      <p class="danger-zone-desc">
        Permanently delete this event and all of its data. This action <strong>cannot</strong> be undone.
      </p>
      {{ include('event/_delete_form.html.twig') }}
    </div>

  </div>
</div>
{% endblock %}
