{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}Event Portal{% endblock %} — EventPortal</title>

    {# ── Favicon (placeholder emoji, replace with your icon) ── #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎪</text></svg>">

    {# ── Bootstrap 5 CSS ── #}
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
        crossorigin="anonymous"
    >

    {# ── Bootstrap Icons ── #}
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    {# ── Custom Event Theme ── #}
    <link rel="stylesheet" href="{{ asset('css/event_theme.css') }}">

    {# ── Apply saved theme BEFORE render to avoid flash ── #}
    <script>
        (function() {
            var saved = localStorage.getItem('ep-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', saved);
        })();
    </script>

    {% block stylesheets %}{% endblock %}
    {% block head_extra %}{% endblock %}
</head>
<body>

{# ============================================================
   NAVBAR
   ============================================================ #}
<nav class="navbar navbar-expand-lg" aria-label="Main navigation">
    <div class="container">

        {# ── Brand ── #}
        <a class="navbar-brand" href="{{ path('app_home') ?? '/' }}">
            <span class="brand-icon" aria-hidden="true">🎪</span>
            EventPortal
        </a>

        {# ── Mobile toggler ── #}
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#mainNav"
            aria-controls="mainNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        {# ── Nav links ── #}
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                <li class="nav-item">
                    <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}"
                       href="{{ path('app_home') ?? '/' }}">
                        <i class="bi bi-house me-1" aria-hidden="true"></i>Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link {% if app.request.attributes.get('_route') starts with 'app_event' %}active{% endif %}"
                       href="{{ path('app_event_index') ?? '/events' }}">
                        <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Events
                    </a>
                </li>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'app_home' %}active{% endif %}"
                           href="{{ path('app_home') ?? '/' }}">
                            <i class="bi bi-ticket-perforated me-1" aria-hidden="true"></i>My Registrations
                        </a>
                    </li>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Admin
                        </a>
                        <ul class="dropdown-menu">
                            <li><span class="dropdown-header">Management</span></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_event_new') ?? '/events/new' }}">
                                    <i class="bi bi-plus-circle me-2"></i>Create Event
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_user_index') ?? '/users' }}">
                                    <i class="bi bi-people me-2"></i>Users
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_review_index') ?? '/reviews' }}">
                                    <i class="bi bi-chat-square-text me-2"></i>All Reviews
                                </a>
                            </li>
                        </ul>
                    </li>
                {% endif %}

            </ul>

            {# ── Right side: Auth + Dark Mode ── #}
            <ul class="navbar-nav align-items-lg-center gap-2">

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2"
                           href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="reviewer-avatar" style="width:1.8rem;height:1.8rem;font-size:.75rem;display:inline-flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(135deg,var(--ep-primary),#9333EA);color:#fff;font-weight:700;">
                                {{ app.user.email|first|upper }}
                            </span>
                            <span class="d-none d-lg-inline" style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                {{ app.user.email }}
                            </span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-header">
                                    <i class="bi bi-person-circle me-1"></i>
                                    {{ app.user.email }}
                                </span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') ?? '/logout' }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') ?? '/login' }}">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-primary btn-sm px-3" href="{{ path('app_register') ?? '/register' }}">
                            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Register
                        </a>
                    </li>
                {% endif %}

                {# ── Dark Mode Toggle ── #}
                <li class="nav-item">
                    <button id="darkModeToggle" title="Toggle dark/light mode" aria-label="Toggle colour scheme">
                        <span class="toggle-icon" aria-hidden="true">🌙</span>
                        <span class="toggle-label">Dark</span>
                    </button>
                </li>

            </ul>
        </div>{# /navbar-collapse #}
    </div>{# /container #}
</nav>

{# ============================================================
   FLASH MESSAGES
   ============================================================ #}
{% set flashTypes = {
    'success': { 'bs': 'success', 'icon': 'bi-check-circle-fill' },
    'error':   { 'bs': 'danger',  'icon': 'bi-exclamation-triangle-fill' },
    'danger':  { 'bs': 'danger',  'icon': 'bi-exclamation-triangle-fill' },
    'warning': { 'bs': 'warning', 'icon': 'bi-exclamation-circle-fill' },
    'info':    { 'bs': 'info',    'icon': 'bi-info-circle-fill' },
    'notice':  { 'bs': 'info',    'icon': 'bi-info-circle-fill' }
} %}

{% for type, messages in app.flashes %}
    {% set cfg = flashTypes[type] ?? { 'bs': 'info', 'icon': 'bi-bell-fill' } %}
    {% for message in messages %}
        <div class="alert alert-{{ cfg.bs }} alert-dismissible fade show mx-auto mt-3"
             style="max-width:860px;"
             role="alert">
            <i class="bi {{ cfg.icon }} me-2" aria-hidden="true"></i>
            {{ message }}
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

{# ============================================================
   MAIN CONTENT
   ============================================================ #}
<main class="flex-grow-1">
    {% block body %}{% endblock %}
</main>

{# ============================================================
   FOOTER
   ============================================================ #}
<footer>
    <div class="container">
        <div class="row align-items-center gy-3">
            <div class="col-12 col-md-4">
                <span class="footer-brand">
                    <span aria-hidden="true">🎪</span> EventPortal
                </span>
                <p class="mb-0 mt-1" style="font-size:.8rem;">
                    Create, join & review amazing events.
                </p>
            </div>
            <div class="col-12 col-md-4 text-md-center">
                <nav aria-label="Footer links">
                    <a href="{{ path('app_home') ?? '/' }}" class="me-3">Home</a>
                    <a href="{{ path('app_event_index') ?? '/events' }}" class="me-3">Events</a>
                    {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                        <a href="{{ path('app_login') ?? '/login' }}">Login</a>
                    {% endif %}
                </nav>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <small>&copy; {{ "now"|date("Y") }} EventPortal. All rights reserved.</small>
            </div>
        </div>
    </div>
</footer>

{# ============================================================
   SCRIPTS
   ============================================================ #}
{# ── Bootstrap 5 JS Bundle (includes Popper) ── #}
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
    crossorigin="anonymous"
></script>

{# ── Dark Mode Toggle Script ── #}
<script>
(function () {
    var btn       = document.getElementById('darkModeToggle');
    var htmlEl    = document.documentElement;
    var icon      = btn ? btn.querySelector('.toggle-icon')  : null;
    var label     = btn ? btn.querySelector('.toggle-label') : null;
    var STORAGE   = 'ep-theme';

    function applyTheme(theme) {
        htmlEl.setAttribute('data-bs-theme', theme);
        localStorage.setItem(STORAGE, theme);
        if (icon)  icon.textContent  = theme === 'dark' ? '☀️' : '🌙';
        if (label) label.textContent = theme === 'dark' ? 'Light' : 'Dark';
        if (btn)   btn.setAttribute('title', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
        if (btn)   btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    }

    /* Init from storage */
    applyTheme(localStorage.getItem(STORAGE) || 'light');

    /* Toggle on click */
    if (btn) {
        btn.addEventListener('click', function () {
            var current = htmlEl.getAttribute('data-bs-theme') || 'light';
            applyTheme(current === 'dark' ? 'light' : 'dark');
        });
    }

    /* Respect OS preference if no stored value */
    if (!localStorage.getItem(STORAGE)) {
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        applyTheme(mq.matches ? 'dark' : 'light');
        mq.addEventListener('change', function (e) {
            if (!localStorage.getItem(STORAGE)) applyTheme(e.matches ? 'dark' : 'light');
        });
    }
})();
</script>

{% block javascripts %}{% endblock %}
</body>
</html>
